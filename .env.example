TIMESCALE_POSTGRES_USER=flexihome
TIMESCALE_POSTGRES_PASSWORD=flexihome
TIMESCALE_POSTGRES_DB=flexihome
TIMESCALE_POSTGRES_PORT=5432

FLEXIHOME_TIMESCALE_DSN=postgresql://flexihome:flexihome@127.0.0.1:5432/flexihome
FLEXIHOME_TIMESCALE_SCHEMA=flexihome
FLEXIHOME_TIMESCALE_CONNECT_TIMEOUT=5

# Optional real market data. Leave these blank for synthetic fallback.
FLEXIHOME_MARKET_DATA_MODE=auto
FLEXIHOME_MARKET_DATA_PERSIST=1
FLEXIHOME_MARKET_DATA_TABLE=market_data_observations
FLEXIHOME_FINGRID_MIN_INTERVAL_SECONDS=2.1
FLEXIHOME_FINGRID_MAX_RETRIES=4
ENTSOE_API_KEY=
FINGRID_API_KEY=

# Fingrid Open Data dataset IDs used by the market data overlay.
FLEXIHOME_FINGRID_FCRN_PRICE_DATASET_ID=317
FLEXIHOME_FINGRID_AFRR_UP_CAPACITY_PRICE_DATASET_ID=52
FLEXIHOME_FINGRID_AFRR_DOWN_CAPACITY_PRICE_DATASET_ID=51
FLEXIHOME_FINGRID_AFRR_UP_ENERGY_PRICE_DATASET_ID=347
FLEXIHOME_FINGRID_AFRR_DOWN_ENERGY_PRICE_DATASET_ID=348
FLEXIHOME_FINGRID_AFRR_UP_ACTIVATION_DATASET_ID=349
FLEXIHOME_FINGRID_AFRR_DOWN_ACTIVATION_DATASET_ID=350
